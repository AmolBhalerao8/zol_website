NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase Postgres (replace placeholders — never commit real passwords)
# Pooler (runtime / Vercel): Supabase Dashboard > Connect > Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (migrations / db push): Supabase Dashboard > Connect > Direct connection
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Vapi voice channel
VAPI_API_KEY=""
VAPI_PRIVATE_KEY=""
VAPI_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL=""

# Conversation intelligence extraction
OPENAI_API_KEY=""

# Integration credential encryption (32+ character secret)
ENCRYPTION_KEY=""

# Tekmetric sync — use mock data when real API access is unavailable
TEKMETRIC_MOCK_MODE="true"
