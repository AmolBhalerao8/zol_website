generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  name        String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships WorkspaceMember[]
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  businessType String
  phone        String?
  website      String?
  timezone     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members            WorkspaceMember[]
  aiEmployeeSettings AIEmployeeSettings?
  communicationChannel CommunicationChannel?
  conversations      Conversation[]
  actionItems        ActionItem[]
  customers          Customer[]
  customerMemories   CustomerMemory[]
  integrations       Integration[]
  tekmetricSyncLogs       TekmetricSyncLog[]
  tekmetricCustomers      TekmetricCustomer[]
  tekmetricVehicles       TekmetricVehicle[]
  tekmetricAppointments   TekmetricAppointment[]
  tekmetricRepairOrders   TekmetricRepairOrder[]
  intelligenceQueries     IntelligenceQuery[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  STAFF
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

enum CommunicationTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  CONCISE
}

model AIEmployeeSettings {
  id                String            @id @default(cuid())
  workspaceId       String            @unique
  displayName       String
  greetingMessage   String
  communicationTone CommunicationTone
  businessContext   String?
  commonScenarios   Json?
  businessHours     Json
  escalationPhone   String?
  escalationEmail   String?
  enabledCapabilities Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum CommunicationProvider {
  VAPI
}

enum CommunicationChannelStatus {
  PENDING
  ACTIVE
  FAILED
}

model CommunicationChannel {
  id                 String                     @id @default(cuid())
  workspaceId        String                     @unique
  provider           CommunicationProvider
  phoneNumber        String?
  phoneAreaCode      String?
  vapiAssistantId    String?
  vapiPhoneNumberId  String?
  voiceId            String
  voiceName          String
  voiceProvider      String                     @default("vapi")
  status             CommunicationChannelStatus
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([vapiAssistantId])
  @@index([vapiPhoneNumberId])
}

enum ConversationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  URGENT
  UNKNOWN
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model Conversation {
  id                     String             @id @default(cuid())
  workspaceId            String
  communicationChannelId String
  vapiCallId             String             @unique
  customerName           String?
  customerPhone          String?
  transcript             String?
  transcriptUrl          String?
  recordingUrl           String?
  summary                String?
  urgency                Urgency            @default(UNKNOWN)
  status                 ConversationStatus @default(PROCESSING)
  startedAt              DateTime?
  endedAt                DateTime?
  durationSeconds        Int?
  rawProviderPayload     Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  communicationChannel CommunicationChannel @relation(fields: [communicationChannelId], references: [id], onDelete: Cascade)
  actionItems          ActionItem[]
  customerLink         ConversationCustomerLink?
  customerMemories     CustomerMemory[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([communicationChannelId])
}

enum MemoryCategory {
  PREFERENCE
  ISSUE
  ORDER_HISTORY
  SERVICE_HISTORY
  COMMUNICATION_STYLE
  BUSINESS_CONTEXT
  FOLLOW_UP
  GENERAL
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String?
  primaryPhone String?
  primaryEmail String?
  notes        String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memories          CustomerMemory[]
  conversationLinks ConversationCustomerLink[]
  tekmetricCustomers TekmetricCustomer[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, primaryPhone])
  @@index([workspaceId, primaryEmail])
}

model ConversationCustomerLink {
  id              String   @id @default(cuid())
  conversationId  String   @unique
  customerId      String
  confidenceScore Float?
  matchedBy       String?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerMemory {
  id              String         @id @default(cuid())
  workspaceId     String
  customerId      String
  conversationId  String?
  content         String
  category        MemoryCategory
  importanceScore Float?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, customerId, createdAt(sort: Desc)])
  @@index([customerId, category])
  @@index([conversationId])
}

model ActionItem {
  id             String             @id @default(cuid())
  workspaceId    String
  conversationId String
  title          String
  description    String?
  priority       ActionItemPriority @default(MEDIUM)
  status         ActionItemStatus   @default(OPEN)
  dueAt          DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([conversationId])
}

enum IntegrationProvider {
  TEKMETRIC
  SHOPMONKEY
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  FAILED
}

model Integration {
  id                   String              @id @default(cuid())
  workspaceId          String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(NOT_CONNECTED)
  credentialsEncrypted String?
  metadata             Json?
  lastConnectedAt      DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tekmetricSyncLogs     TekmetricSyncLog[]
  tekmetricCustomers    TekmetricCustomer[]
  tekmetricVehicles     TekmetricVehicle[]
  tekmetricAppointments TekmetricAppointment[]
  tekmetricRepairOrders TekmetricRepairOrder[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

enum TekmetricSyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model TekmetricSyncLog {
  id            String              @id @default(cuid())
  workspaceId   String
  integrationId String
  status        TekmetricSyncStatus
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  errorMessage  String?
  recordsSynced Json?
  createdAt     DateTime            @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([integrationId, createdAt(sort: Desc)])
}

model TekmetricCustomer {
  id            String   @id @default(cuid())
  workspaceId   String
  integrationId String
  externalId    String
  zolCustomerId String?
  name          String?
  phone         String?
  email         String?
  rawData       Json
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  zolCustomer Customer?   @relation(fields: [zolCustomerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, integrationId, externalId])
  @@index([workspaceId, zolCustomerId])
  @@index([workspaceId, phone])
  @@index([workspaceId, email])
}

model TekmetricVehicle {
  id                   String   @id @default(cuid())
  workspaceId          String
  integrationId        String
  externalId           String
  tekmetricCustomerId  String?
  zolCustomerId        String?
  year                 String?
  make                 String?
  model                String?
  vin                  String?
  rawData              Json
  lastSyncedAt         DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, integrationId, externalId])
  @@index([workspaceId, zolCustomerId])
  @@index([workspaceId, tekmetricCustomerId])
}

model TekmetricAppointment {
  id                  String    @id @default(cuid())
  workspaceId         String
  integrationId       String
  externalId          String
  tekmetricCustomerId String?
  zolCustomerId       String?
  scheduledAt         DateTime?
  status              String?
  summary             String?
  rawData             Json
  lastSyncedAt        DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, integrationId, externalId])
  @@index([workspaceId, zolCustomerId])
  @@index([workspaceId, scheduledAt])
}

model TekmetricRepairOrder {
  id                  String   @id @default(cuid())
  workspaceId         String
  integrationId       String
  externalId          String
  tekmetricCustomerId String?
  zolCustomerId       String?
  status              String?
  totalAmount         String?
  summary             String?
  rawData             Json
  lastSyncedAt        DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, integrationId, externalId])
  @@index([workspaceId, zolCustomerId])
  @@index([workspaceId, status])
}

model IntelligenceQuery {
  id          String   @id @default(cuid())
  workspaceId String
  query       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
}
